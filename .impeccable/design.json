      "css": ".ds-payment{display:flex;gap:14px;align-items:center;padding:17px;border-radius:10px;background:var(--cream);font-family:var(--body);color:var(--ink)}.ds-payment svg{width:25px;height:25px;fill:none;stroke:var(--coral);stroke-width:1.65;stroke-linecap:round;flex-shrink:0}.ds-payment strong{display:block;font-size:14px}.ds-payment span{display:block;font-size:12px;color:var(--muted);margin-top:4px}"
