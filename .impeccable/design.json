      "css": ".ds-categories{display:flex;gap:8px;flex-wrap:wrap}.ds-category{font-family:var(--body);font-size:14px;min-height:44px;padding:10px 16px;border:1px solid var(--line);border-radius:10px;background:transparent;color:var(--ink);cursor:pointer}.ds-category:hover{background:var(--cream)}.ds-category.ds-selected,.ds-category.ds-selected:hover{background:var(--ink);border-color:var(--ink);color:var(--paper)}.ds-category:focus-visible{outline:3px solid var(--coral);outline-offset:4px}"
