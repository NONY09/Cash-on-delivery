      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:14px;min-height:52px;padding:15px 24px;font-family:var(--body);font-weight:700;font-size:15px;line-height:1.2;border:1px solid transparent;border-radius:10px;cursor:pointer;transition:background .18s ease,color .18s ease}.ds-button:focus-visible{outline:3px solid var(--coral);outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-button{transition:none}}.ds-secondary{background:transparent;border-color:var(--line);color:var(--ink)}.ds-secondary:hover{background:var(--cream)}"
