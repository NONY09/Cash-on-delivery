      "html": "<label class=\"ds-search\"><span class=\"ds-search-label\">Buscar</span><input aria-label=\"Buscar produtos\" placeholder=\"O que você procura?\"></label>",
      "css": ".ds-search{display:flex;align-items:center;gap:12px;max-width:420px;background:var(--cream);border-radius:10px;padding:3px 8px 3px 16px;color:var(--ink);font-family:var(--body)}.ds-search-label{font-size:14px}.ds-search input{font:inherit;font-size:14px;min-width:0;width:100%;border:0;background:none;color:var(--ink);padding:11px 0;border-radius:10px;caret-color:var(--coral)}.ds-search input::placeholder{color:var(--muted);opacity:1}.ds-search input:focus-visible{outline:3px solid var(--coral);outline-offset:4px}"
    },
    {
      "name": "Store navigation",
      "kind": "nav",
      "description": "Plain links separated from the main header by a fine border.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Loja\"><a href=\"#catalogo\">Produtos</a><a href=\"#como-funciona\">Como funciona</a><a href=\"#ajuda\">Ajuda</a></nav>",
      "css": ".ds-nav{display:flex;gap:32px;border-top:1px solid var(--line);padding:16px 0;font-family:var(--body);font-size:14px;color:var(--ink)}.ds-nav a{color:inherit;text-decoration:none;text-underline-offset:4px}.ds-nav a:hover{text-decoration:underline}.ds-nav a:focus-visible{outline:3px solid var(--coral);outline-offset:4px}@media(max-width:760px){.ds-nav{gap:22px;font-size:13px}}"
    },
    {
      "name": "Category control",
      "kind": "chip",
      "refersTo": "category-active",
      "description": "Circular highlights with a coral selection ring and separate label; preview uses the existing bag icon.",
      "html": "<button class=\"ds-category\" aria-pressed=\"true\"><span class=\"ds-photo\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5 7h14l1 14H4L5 7Z\"/><path d=\"M8 8V6a4 4 0 0 1 8 0v2\"/></svg></span><span class=\"ds-name\">Todos</span></button>",
      "css": ".ds-category{display:flex;flex-direction:column;align-items:center;gap:12px;flex:0 0 112px;min-height:142px;border:0;border-radius:10px;padding:0;background:none;text-align:center;font-family:var(--body);font-size:13px;line-height:1.4;color:var(--ink);cursor:pointer}.ds-photo{display:grid;place-items:center;width:94px;height:94px;flex:none;overflow:hidden;padding:4px;border:2px solid transparent;border-radius:50%;background:var(--cream);transition:border-color .18s ease}.ds-photo svg{width:34px;height:34px;fill:none;stroke:var(--muted);stroke-width:1.65}.ds-category:hover .ds-photo{border-color:var(--line)}.ds-category[aria-pressed=\"true\"] .ds-photo{border-color:var(--coral)}.ds-category[aria-pressed=\"true\"] .ds-name{color:var(--coral);font-weight:700}.ds-category[aria-pressed=\"true\"] svg{stroke:var(--coral)}.ds-category:focus-visible{outline:3px solid var(--coral);outline-offset:4px}@media(max-width:760px){.ds-category{flex-basis:96px;min-height:124px;font-size:12px;gap:10px}.ds-photo{width:80px;height:80px}}@media(prefers-reduced-motion:reduce){.ds-photo{transition:none}}"
    },
    {
      "name": "Product card frame",
      "kind": "card",
      "refersTo": "product-image",
      "description": "Image frame and unboxed product information; preview intentionally omits product photography.",
      "html": "<article class=\"ds-card\"><a class=\"ds-card-image\" href=\"#produto\" aria-label=\"Ver produto\"><span class=\"ds-tag\">Exemplo demonstrativo</span></a><div class=\"ds-card-body\"><div><span class=\"ds-label\">Categoria</span><h3>Produto de exemplo</h3><p>Informações do produto</p></div><div class=\"ds-price\"><strong>R$ 00,00</strong><small>Preço demonstrativo</small></div><a class=\"ds-card-cta\" href=\"#produto\">Escolher kit</a></div></article>",
      "css": ".ds-card{max-width:540px;min-width:0;display:flex;flex-direction:column;font-family:var(--body);color:var(--ink)}.ds-card-image{display:block;position:relative;aspect-ratio:1;background:var(--peach);border-radius:16px;overflow:hidden}.ds-card-image:focus-visible,.ds-card-cta:focus-visible{outline:3px solid var(--coral);outline-offset:4px}.ds-tag{position:absolute;top:18px;left:18px;font-size:12px;background:var(--forest);color:var(--on-forest);padding:7px 10px;border-radius:6px}.ds-card-body{display:flex;flex-direction:column;gap:18px;padding-top:22px;flex:1}.ds-label{font-size:12px;color:var(--muted)}.ds-card h3{font-size:21px;line-height:1.15;margin:6px 0 0;font-weight:700}.ds-card p{font-size:14px;color:var(--muted);margin:7px 0 0}.ds-price{display:flex;flex-direction:column;font-variant-numeric:tabular-nums}.ds-price strong{font-size:22px;line-height:1.2;color:var(--forest)}.ds-price small{font-size:12px;color:var(--muted);margin-top:7px}.ds-card-cta{display:flex;justify-content:center;align-items:center;min-height:52px;padding:15px 24px;border:1px solid var(--coral);border-radius:10px;color:var(--coral);font-weight:700;font-size:15px;text-decoration:none;transition:background .18s ease,color .18s ease}.ds-card-cta:hover{background:var(--peach)}@media(prefers-reduced-motion:reduce){.ds-card-cta{transition:none}}"
    },
