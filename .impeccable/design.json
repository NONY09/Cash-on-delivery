      "css": ".ds-nav{display:flex;gap:32px;border-top:1px solid var(--line);padding:16px 0;font-family:var(--body);font-size:14px;color:var(--ink)}.ds-nav a{color:inherit;text-decoration:none;text-underline-offset:4px}.ds-nav a:hover{text-decoration:underline}.ds-nav a:focus-visible{outline:3px solid var(--coral);outline-offset:4px}@media(max-width:760px){.ds-nav{gap:22px;font-size:13px}}"
